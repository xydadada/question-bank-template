# Copy this file to .env. Never commit .env.

# MinerU: at least one key is required for document parsing.
MINERU_API_TOKEN=
MINERU_API_TOKEN_BACKUP=
# Add more independent keys when needed:
# MINERU_API_TOKEN_3=
# MINERU_API_TOKEN_4=

# MiMo: used for image understanding and uncertain document classification.
MIMO_API_KEY=
# MIMO_API_KEY_2=
# MIMO_API_KEY_3=

# Optional CLI fallback. Normally the WeKnora CLI stores credentials in the
# Windows credential manager, so no WeKnora key is needed here.
WEKNORA_HOST=http://127.0.0.1:8080

# Keep empty for safe defaults. Set this exact value only after enabling one of
# the permanent-delete switches in config.local.yaml and accepting data loss.
QUESTION_BANK_ALLOW_PERMANENT_DELETE=

# Optional MCP publication settings. Do not put an OAuth password here.
MCP_EXTERNAL_URL=https://mcp.example.com
MCP_PUBLIC_HOSTNAME=mcp.example.com
CLOUDFLARE_TUNNEL_NAME=question-bank-mcp
